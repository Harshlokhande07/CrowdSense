# ==============================================================================
# CrowdSense Environment Configuration (.env.example)
# Copy this file to .env and configure local values.
# NEVER commit real credentials to version control.
# ==============================================================================

# Server & Network Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# API Security & Authentication
# Required on /ws, upload, source select, ack, resolve, and test notify.
# Outside --demo mode, server fails closed (401) if unset.
CROWDSENSE_API_KEY=
API_AUTH_KEY=
# Separate token for mobile camera streaming (GET /mobile and WS /ws/mobile-cam)
MOBILE_CAM_TOKEN=
# Mobile camera target frame rate (default 10 FPS)
MOBILE_FPS=10
# Optional ngrok auth token for pyngrok / ngrok tunnel in scripts/run_mobile.py
NGROK_AUTHTOKEN=
# Set to true to require API key even on public GET /api/state, /video/feed, and /api/alerts (recommended before running tunnels/ngrok)
REQUIRE_AUTH_READS=false

# Computer Vision & Detection Pipeline
VIDEO_SRC=crowd.mp4
# Local Webcam Hardware Configuration (when VIDEO_SRC=webcam)
WEBCAM_INDEX=0
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
WEBCAM_AUTOSTART=true
# Android IP Webcam Configuration (when VIDEO_SRC=ipcam)
IPCAM_URL=http://<phone-ip>:8080
IPCAM_PATH=/video
IPCAM_USER=
IPCAM_PASS=
IPCAM_RETRY_SEC=3
IPCAM_TIMEOUT_SEC=5
# YOLO Model & Inference Size (e.g. yolov8n.pt, yolov8s.pt, yolov8m.pt; imgsz 640, 960, 1280)
YOLO_MODEL=yolov8n.pt
YOLO_IMGSZ=640
CONF_THRESHOLD=0.35
GRID_SIZE=8

# Multi-Camera Configuration (Supports 1 to 4 cameras, JSON array format)
# Leave blank to use default single camera (VIDEO_SRC)
# CAMERAS=[{"id": "cam-1", "name": "Main Concourse", "source": "crowd.mp4"}, {"id": "cam-2", "name": "North Gate", "source": "gate.mp4"}]
CAMERAS=
CAMERA_NAME=Main Entrance Camera

# Simulation / Demo Mode
DEMO_MODE=false

# Movement & Stagnation Constraints
MIN_ZONE_COUNT_FOR_MOVEMENT=3

# Prototype Risk Thresholds (Cell density person counts)
# Note: Prototype risk thresholds only. All alerts require human verification.
DENSITY_NORMAL_MAX=2
DENSITY_ELEVATED_MAX=4
DENSITY_HIGH_MAX=6
# >= 7 is CRITICAL (In demo mode: >= 4 is CRITICAL)

# Push Notification (ntfy.sh)
NTFY_TOPIC=crowdsense_demo_alerts
ENABLE_MOBILE_ALERT=true

# Twilio SMS & WhatsApp Configuration (Configure in your private local .env)
TWILIO_ACCOUNT_SID=
# Preferred Auth: API Key SID + Secret (Leave blank to use AUTH_TOKEN)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Fallback Auth: Primary Auth Token
TWILIO_AUTH_TOKEN=

# Sender: Messaging Service SID (Priority) or Twilio Phone Number (E.164 format)
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Alert Recipients (Comma-separated E.164 phone numbers, e.g. +919876543210,+12025550123)
ALERT_PHONE_NUMBERS=

# Optional Zone-specific recipients mapping JSON (e.g. {"ZONE_A": ["+919876543210"]})
ZONE_RECIPIENTS=

# SMS Alert Policy
SMS_MIN_LEVEL=HIGH
SMS_COOLDOWN_SEC=30.0
SMS_SEND_RESOLVED=true
# Channel: "sms" or "whatsapp"
TWILIO_CHANNEL=sms

# Firestore Cloud Incident Storage (Optional)
# Absolute or relative path to serviceAccountKey.json
FIREBASE_KEY_PATH=

# Telemetry & WebSocket Streaming
WS_BROADCAST_HZ=8.0

# Alert State Machine & Hysteresis
DEESCALATION_HYSTERESIS_SEC=3.0
DEESCALATION_HYSTERESIS_MARGIN=5.0
ALERT_COOLDOWN_SEC=30.0

# Opposing Flow Detection
OPPOSING_FLOW_MIN_SPEED=0.01
OPPOSING_FLOW_MIN_COUNT=4
OPPOSING_FLOW_ANGLE_DEG=120.0

# Physical Camera Ground Plane Calibration (4 points: x1,y1;x2,y2;x3,y3;x4,y4)
CAMERA_CALIBRATION_POINTS=
