# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# Computer Vision & Detection
VIDEO_SRC=crowd.mp4
# YOLO Model & Inference Size (e.g. yolov8n.pt, yolov8s.pt, yolov8m.pt; imgsz 640, 960, 1280)
YOLO_MODEL=yolov8n.pt
YOLO_IMGSZ=640
CONF_THRESHOLD=0.35
GRID_SIZE=8

# Simulation / Demo Mode
DEMO_MODE=false

# Movement & Stagnation Constraints
MIN_ZONE_COUNT_FOR_MOVEMENT=3

# Prototype Risk Thresholds (Cell density person counts)
# Note: Prototype risk thresholds only. All alerts require human verification.
DENSITY_NORMAL_MAX=2
DENSITY_ELEVATED_MAX=4
DENSITY_HIGH_MAX=6
# >= 7 is CRITICAL

# Alert & Notification Integrations
NTFY_TOPIC=crowdsense_demo_alerts
ENABLE_MOBILE_ALERT=true

# Twilio SMS & WhatsApp Configuration (Set locally in your private .env)
TWILIO_ACCOUNT_SID=
# Preferred Auth: API Key SID + Secret (Leave blank to use AUTH_TOKEN)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Fallback Auth: Primary Auth Token
TWILIO_AUTH_TOKEN=

# Sender: Messaging Service SID (Priority) or Twilio Phone Number (E.164)
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Alert Recipients (Comma-separated E.164, e.g. +919876543210,+12025550123)
ALERT_PHONE_NUMBERS=

# Optional Zone-specific recipients JSON (e.g. {"ZONE_A": ["+919876543210"]})
ZONE_RECIPIENTS=

# SMS Alert Policy
SMS_MIN_LEVEL=HIGH
SMS_COOLDOWN_SEC=30.0
SMS_SEND_RESOLVED=true
# Channel: "sms" or "whatsapp"
TWILIO_CHANNEL=sms

# Security & Authentication (Optional)
API_AUTH_KEY=

# Telemetry & Streaming
WS_BROADCAST_HZ=8.0

# Alert State Machine & Hysteresis
DEESCALATION_HYSTERESIS_SEC=3.0
DEESCALATION_HYSTERESIS_MARGIN=5.0
ALERT_COOLDOWN_SEC=30.0

# Opposing Flow Detection
OPPOSING_FLOW_MIN_SPEED=0.01
OPPOSING_FLOW_MIN_COUNT=4
OPPOSING_FLOW_ANGLE_DEG=120.0

# Physical Camera Ground Plane Calibration (4 points: x1,y1;x2,y2;x3,y3;x4,y4)
CAMERA_CALIBRATION_POINTS=

